{
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 200000,
  "autoMemoryEnabled": false,
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "effortLevel": "low",
  "enabledPlugins": {},
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status waiting",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "workmux register-agent",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|fork"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/Users/simon/.claude/hooks/caveman-refresh.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "low"
    }
  },
  "remoteControlAtStartup": true,
  "showClearContextOnPlanAccept": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "/Users/simon/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "voiceEnabled": true
}
